#!/usr/bin/env ruby
$LOAD_PATH << File.expand_path(File.dirname(__FILE__) + '/../lib')
require 'gli'
require 'mmw'
require 'score.rb'
require 'rubygems'
include GLI::App
include Score

PROJECT_DIR = File.expand_path('~/My-Project')

class App
  extend GLI::App
  config_file File.join(ENV['HOME'],'.mmw.rc.yaml')

  program_desc """
    Write and produce music. User needs to manually make 'notes-ns' file -
    before using score command and after the session is created.
  """
  version Mmw::VERSION

  subcommand_option_handling :normal

  desc 'Path to the project folder'
  default_value PROJECT_DIR
  arg_name 'project_folder'
  flag [:n,:projname]

  desc 'Describe create here'
  arg_name 'Project Name'
  command :session do |c|
    c.desc 'Describe a switch to create'
    c.switch :s
    c.flag :f

    c.action do |global_options,options,args|
      projpath = File.expand_path(global_options[:f] || PROJECT_DIR)
                                                                                     
      if Dir.exist?(projpath)                                                        
        puts "Directory exists"                                                      
      else                                                                           
        print "#{projpath} does not exist. Do you want to create it? y or n: "       
        choice = $stdin.gets.chomp                                                   
                                                                                     
        if choice.downcase == 'y'                                                    
          directories = [                                                            
            projpath,                                                                
            "#{projpath}/projname.eca",                                                   
          ]                                                                          
                                                                                     
          directories.each { |dir| Dir.mkdir(dir) unless Dir.exist?(dir) }           
                                                                                     
          system("ffmpeg -f lavfi -i anullsrc=channel_layout=stereo:sample_rate=48000 -t 5 '#{projpath}/audio/stems/recorded/input.wav'")                              
          puts "#{projpath} created"                                                 
        else                                                                         
          puts "#{projpath} not created"                                             
        end                                                                          
      end                                                                            
    end
  end

  desc 'Create a .ly file'
  arg_name '<filename>'
  command :score do |c|
    c.desc 'Name of the lilypond file'
    c.arg_name 'filename'
    c.flag :filename

    c.action do |global_options,options,args|
      build_score(global_options,options,args)
      render_score(global_options,options,args)
    end
  end

  command :sounddesign do |c|
    c.action do |global_options,options,args|
      render_sound(global_options,options,args)
    end
  end

  desc 'Describe clear here'
  arg_name 'Describe arguments to clear here'
  command :clear do |c|
    c.action do |global_options,options,args|
      puts "clear command ran"
    end
  end

  pre do |global,command,options,args|
    # Pre logic here
    # Return true to proceed; false to abort and not call the
    # chosen command
    # Use skips_pre before a command to skip this block
    # on that command only
    true
  end

  post do |global,command,options,args|
    # Post logic here
    # Use skips_post before a command to skip this
    # block on that command only
  end

  on_error do |exception|
    # Error logic here
    # return false to skip default error handling
    true
  end
end

exit App.run(ARGV)
